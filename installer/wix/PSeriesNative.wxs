<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="PSeries Native"
    Manufacturer="PSeries Native"
    Version="0.1.0"
    UpgradeCode="50A7F9A8-8A66-4F5F-9DC8-3A2F6E5FC2D1"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="A newer PSeries Native version is already installed."
      Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PSeries Native">
        <Component Id="PSeriesServiceComponent"
                   Guid="6F0B7DF6-7E10-4F15-8D44-EC15A8B2A9F1"
                   Bitness="always64">
          <File Id="PSeriesServiceExe"
                Source="$(var.PSeriesServiceExe)"
                Name="PSeriesService.exe"
                KeyPath="yes" />

          <ServiceInstall
            Id="PSeriesServiceInstall"
            Name="PSeriesService"
            DisplayName="PSeries Native Service"
            Description="PSeries Native read-only discovery and recovery service"
            Start="auto"
            Type="ownProcess"
            ErrorControl="normal"
            Vital="yes"
            Account="NT AUTHORITY\LocalService" />

          <ServiceControl
            Id="PSeriesServiceControl"
            Name="PSeriesService"
            Start="install"
            Stop="both"
            Remove="uninstall" />

          <RegistryKey Root="HKLM" Key="SOFTWARE\PSeriesNative">
            <RegistryValue
              Name="InstalledVersion"
              Type="string"
              Value="0.1.0"
              KeyPath="no" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="PSeries Native" Level="1">
      <ComponentRef Id="PSeriesServiceComponent" />
    </Feature>
  </Package>
</Wix>
